{
  "kind": "collectionType",
  "collectionName": "noticias",
  "info": {
    "singularName": "noticia",
    "pluralName": "noticias",
    "displayName": "Notícia",
    "description": "Notícias do blog FUT LANCE"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titulo": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "titulo"
    },
    "resumo": {
      "type": "text",
      "required": true,
      "maxLength": 300
    },
    "conteudo": {
      "type": "richtext",
      "required": true
    },
    "imagem_capa": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"]
    },
    "video_url": {
      "type": "string"
    },
    "categoria": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::categoria.categoria",
      "inversedBy": "noticias"
    },
    "data_publicacao": {
      "type": "date",
      "required": true
    },
    "autor": {
      "type": "string",
      "required": true,
      "default": "FUT LANCE"
    },
    "comentarios": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::comentario.comentario",
      "mappedBy": "noticia"
    }
  }
}
